  {
    "id": "f4c85d1e",
    "topic": "Probability",
    "subtopic": "E9.3",
    "tier": "Extended",
    "paper_type": "Paper 4 (Calculator)",
    "difficulty": "Medium",
    "total_marks": 7,
    "intro_text": "A bag contains $3$ red balls and $2$ blue balls. Two balls are drawn from the bag, one after the other, without replacement.",
    "intro_diagram_tikz": "",
    "parts": [
      {
        "label": "(a)",
        "context": "",
        "diagram_tikz": "\\begin{tikzpicture}[level distance=3.5cm, level 1/.style={sibling distance=3.0cm}, level 2/.style={level distance=3.5cm, sibling distance=1.8cm}]\n  \\node (root) {}\n    child { node {$R$}\n      edge from parent node[above] {\\footnotesize $\\dfrac{3}{5}$}\n      child { node {$R$} edge from parent node[above] {\\footnotesize $\\underline{\\hspace{0.8cm}}$} }\n      child { node {$B$} edge from parent node[above] {\\footnotesize $\\dfrac{1}{2}$} }\n    }\n    child { node {$B$}\n      edge from parent node[above] {\\footnotesize $\\underline{\\hspace{0.8cm}}$}\n      child { node {$R$} edge from parent node[above] {\\footnotesize $\\dfrac{3}{5}$} }\n      child { node {$B$} edge from parent node[above] {\\footnotesize $\\underline{\\hspace{0.8cm}}$} }\n    };\n\\end{tikzpicture}",
        "prompt": "Complete the tree diagram.",
        "marks": 3,
        "vspace_cm": 0.0,
        "answer_type": "null",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "First draw: $B = \\dfrac{2}{5}$ [B1]",
          "$R$ then $R$: $\\dfrac{2}{4}$ or $\\dfrac{1}{2}$ [B1]",
          "$B$ then $B$: $\\dfrac{1}{4}$ [B1]"
        ],
        "subparts": []
      },
      {
        "label": "(b)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the probability that both balls are red.",
        "marks": 2,
        "vspace_cm": 3.0,
        "answer_type": "short_line",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "$\\dfrac{3}{5} \\times \\dfrac{2}{4}$ (product of probabilities along the $RR$ path) [M1]",
          "$\\dfrac{3}{10}$ (or $\\dfrac{6}{20}$) [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(c)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the probability that exactly one ball is red.",
        "marks": 2,
        "vspace_cm": 3.0,
        "answer_type": "line",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "$\\dfrac{3}{5} \\times \\dfrac{2}{4} + \\dfrac{2}{5} \\times \\dfrac{3}{5}$ (sum of the $RB$ and $BR$ paths) [M1]",
          "$\\dfrac{27}{50}$ (or $0.54$) [A1]"
        ],
        "subparts": []
      }
    ]
  },
  {
    "id": "0a9d6e2b",
    "topic": "Functions",
    "subtopic": "E3.3",
    "tier": "Extended",
    "paper_type": "Paper 2 (Non-Calculator)",
    "difficulty": "Medium",
    "total_marks": 8,
    "intro_text": "$f(x) = 3x - 1$, $g(x) = x^2 + 2$.",
    "intro_diagram_tikz": "",
    "parts": [
      {
        "label": "(a)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the value of $gf(2)$.",
        "marks": 2,
        "vspace_cm": 2.5,
        "answer_type": "short_line",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "$f(2) = 3(2) - 1 = 5$ [M1]",
          "$g(5) = 5^2 + 2 = 27$ [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(b)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find $fg(x)$ in its simplest form.",
        "marks": 2,
        "vspace_cm": 3.0,
        "answer_type": "line",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "$f(g(x)) = 3(x^2 + 2) - 1$ [M1]",
          "$3x^2 + 5$ [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(c)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the values of $x$ for which $gf(x) = 19$.",
        "marks": 4,
        "vspace_cm": 6.0,
        "answer_type": "multi_field",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "$x =$, $x =$",
        "markscheme": [
          "$(3x - 1)^2 + 2 = 19$ [M1]",
          "$3x - 1 = \\pm 4$ (from $(3x - 1)^2 = 16$) [M1]",
          "$x = -1$ [A1]",
          "$x = \\dfrac{5}{3}$ [A1]"
        ],
        "subparts": []
      }
    ]
  },
  {
    "id": "1c3f7a4d",
    "topic": "Algebra",
    "subtopic": "E2.5",
    "tier": "Extended",
    "paper_type": "Paper 2 (Non-Calculator)",
    "difficulty": "Hard",
    "total_marks": 8,
    "intro_text": "$f(x) = x^3 - 6x^2 + 11x - 6$.",
    "intro_diagram_tikz": "",
    "parts": [
      {
        "label": "(a)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Show that $(x - 2)$ is a factor of $f(x)$.",
        "marks": 2,
        "vspace_cm": 3.0,
        "answer_type": "null",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "$f(2) = 2^3 - 6(2)^2 + 11(2) - 6$ (correct substitution) [M1]",
          "$f(2) = 8 - 24 + 22 - 6 = 0$ [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(b)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Factorise $f(x)$ completely.",
        "marks": 3,
        "vspace_cm": 4.5,
        "answer_type": "line",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "",
        "markscheme": [
          "Divides $f(x)$ by $(x - 2)$ to obtain $x^2 - 4x + 3$ [M1]",
          "Factorises $x^2 - 4x + 3$ as $(x - 1)(x - 3)$ [M1]",
          "$f(x) = (x - 2)(x - 1)(x - 3)$ [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(c)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Solve the equation $f(x) = 0$.",
        "marks": 3,
        "vspace_cm": 1.5,
        "answer_type": "multi_field",
        "answer_prefix": "",
        "answer_suffix": "",
        "answer_format": "$x =$, $x =$, $x =$",
        "markscheme": [
          "$x = 1$ [A1]",
          "$x = 2$ [A1]",
          "$x = 3$ [A1]"
        ],
        "subparts": []
      }
    ]
  },
  {
    "id": "2e5b8c6f",
    "topic": "Trigonometry",
    "subtopic": "E7.2",
    "tier": "Extended",
    "paper_type": "Paper 4 (Calculator)",
    "difficulty": "Hard",
    "total_marks": 8,
    "intro_text": "A ship sails from port $P$ on a bearing of $065^\\circ$ for $18$ km to reach point $Q$. It then sails on a bearing of $155^\\circ$ for $24$ km to reach point $R$. The diagram shows the route of the ship.",
    "intro_diagram_tikz": "\\begin{tikzpicture}\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at ({3*cos(25)},{3*sin(25)});\n  \\coordinate (R) at ({3*cos(25)+4*cos(-65)},{3*sin(25)+4*sin(-65)});\n  \\draw[->] (P) -- ++(0,2.8) node[right, pos=0.95] {$N$};\n  \\draw[->] (Q) -- ++(0,2.8) node[right, pos=0.95] {$N$};\n  \\draw[thick] (P) -- node[sloped, above] {$18$ km} (Q);\n  \\draw[thick] (Q) -- node[sloped, above] {$24$ km} (R);\n  \\node[below left] at (P) {$P$};\n  \\node[right] at (Q) {$Q$};\n  \\node[below right] at (R) {$R$};\n\\end{tikzpicture}",
    "parts": [
      {
        "label": "(a)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the bearing of $P$ from $Q$, giving a reason.",
        "marks": 2,
        "vspace_cm": 2.0,
        "answer_type": "short_line",
        "answer_prefix": "",
        "answer_suffix": "$^\\circ$",
        "answer_format": "",
        "markscheme": [
          "$065^\\circ + 180^\\circ = 245^\\circ$ [B1]",
          "Reason: back bearing (add $180^\\circ$ to the forward bearing) [B1]"
        ],
        "subparts": []
      },
      {
        "label": "(b)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the distance $PR$.",
        "marks": 3,
        "vspace_cm": 4.5,
        "answer_type": "short_line",
        "answer_prefix": "",
        "answer_suffix": "km",
        "answer_format": "",
        "markscheme": [
          "Angle $PQR = 245^\\circ - 155^\\circ = 90^\\circ$ [M1]",
          "$PR = \\sqrt{18^2 + 24^2}$ (Pythagoras' theorem) [M1]",
          "$30$ km [A1]"
        ],
        "subparts": []
      },
      {
        "label": "(c)",
        "context": "",
        "diagram_tikz": "",
        "prompt": "Find the bearing of $R$ from $P$, giving your answer to the nearest degree.",
        "marks": 3,
        "vspace_cm": 4.5,
        "answer_type": "short_line",
        "answer_prefix": "",
        "answer_suffix": "$^\\circ$",
        "answer_format": "",
        "markscheme": [
          "Angle $QPR = \\tan^{-1}\\left(\\dfrac{24}{18}\\right) \\approx 53.1^\\circ$ [M1]",
          "Bearing $= 065^\\circ + 53.1^\\circ$ [M1]",
          "$118^\\circ$ (to the nearest degree) [A1]"
        ],
        "subparts": []
      }
    ]
  },
