    "intro_text": "The diagram shows a region $R$ on the coordinate grid.",
    "intro_diagram_tikz": "\\begin{tikzpicture}[scale=0.9]\n  \\fill[black!12] (-1,-1) rectangle (6,5);\n  \\fill[white] (3,2) -- (5,4) -- (1,4) -- cycle;\n  \\draw[step=1, gray!70, thin] (-1,-1) grid (6,5);\n  \\draw[->] (-1,0) -- (6.4,0) node[right] {$x$};\n  \\draw[->] (0,-1) -- (0,5.4) node[above] {$y$};\n  \\foreach \\x in {1,2,3,4,5} {\\draw (\\x,-0.08) -- ++(0,0.16);}\n  \\foreach \\y in {1,2,3,4} {\\draw (-0.08,\\y) -- ++(0.16,0);}\n  \\draw[thick] (0,-1) -- (5,4);\n  \\draw[thick] (0,5) -- (5,0);\n  \\draw[thick] (-1,4) -- (6,4);\n  \\node at (3,3.2) {$R$};\n\\end{tikzpicture}",
