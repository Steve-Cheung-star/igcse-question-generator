        "answer_format": "",
        "markscheme": [
          "Base $= 4$, height $= 2$ (or $\\dfrac{1}{2} \\times 4 \\times 2$) [M1]",
          "$4$ [A1]"
        ],
        "subparts": []
      }
    ]
  }
